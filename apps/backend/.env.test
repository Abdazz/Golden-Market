# Valeurs factices pour les tests d'intégration HTTP (test:integration:http /
# test:integration:modules) — jamais utilisées en dev/prod, aucun secret réel.
# Chargé automatiquement par Medusa (loadEnv("test", ...) dans jest.config.js).
#
# DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD sont lus par @medusajs/test-utils
# pour créer/détruire lui-même une base de données éphémère par test file ;
# DATABASE_URL est la config par défaut de l'app, écrasée par le test runner.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/medusa-backend
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=test-only-secret
COOKIE_SECRET=test-only-secret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000
ORANGE_MONEY_NUMBER=+22670000000
ORANGE_MONEY_NAME=Golden Market Test
RESEND_API_KEY=test_dummy_key
RESEND_FROM_EMAIL=test@golden-market.co
STOREFRONT_URL=http://localhost:8001
