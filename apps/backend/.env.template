# En production (NODE_ENV=production), ces 3 valeurs ne doivent jamais
# contenir "localhost" - le garde-fou assertProductionConfig (Phase 2) bloque
# sinon le démarrage du backend.
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# --- Paiement manuel Orange Money (provider custom) ---
# Numéro et nom affichés au client pendant le checkout (instructions de transfert)
ORANGE_MONEY_NUMBER=
ORANGE_MONEY_NAME=Golden Market

# --- Notification marchand (webhook n8n -> WhatsApp) ---
N8N_ORDER_WEBHOOK_URL=

# --- Emails transactionnels (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=commandes@golden-market.co

# --- URL publique du storefront (liens dans les emails) ---
STOREFRONT_URL=http://localhost:8001

# --- Identifiants admin (utilisés par scripts/*.ts, ex. import du catalogue) ---
# MEDUSA_ADMIN_EMAIL=admin@golden-market.co
# MEDUSA_ADMIN_PASSWORD=

# --- Chemin du fichier Excel du catalogue (utilisé par import-catalog.ts) ---
# En production/staging (docker-compose.prod.yml), le fichier est placé
# manuellement une fois par environnement dans catalog-data/ à la racine du
# répertoire de déploiement (jamais commité, monté dans le conteneur backend
# en lecture seule sur /app/catalog-data). Chemin toujours le même, côté
# conteneur, quel que soit l'environnement :
# CATALOG_PATH=/app/catalog-data/Golden Market - Catalogue des produits.xlsx
# Ignoré silencieusement par le workflow de déploiement si absent (import sauté).
