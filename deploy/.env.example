# Copier en deploy/.env et remplir (ne jamais committer le vrai fichier).
# Utilisé par : docker compose --env-file deploy/.env -f docker-compose.prod.yml up -d
# Voir DEPLOYMENT.md pour la procédure complète.

# --- Domaines (reverse proxy Caddy, TLS Let's Encrypt automatique) ---
# Chacun doit avoir un enregistrement DNS A/AAAA pointant vers ce VPS avant le
# premier démarrage (Caddy échoue à obtenir un certificat sinon).
BACKEND_DOMAIN=api.golden-market.co
STOREFRONT_DOMAIN=boutique.golden-market.co
# Adresse utilisée par Let's Encrypt pour les notifications (expiration, etc.)
ACME_EMAIL=

# --- Postgres ---
POSTGRES_DB=medusa-backend
POSTGRES_USER=medusa
POSTGRES_PASSWORD=

# --- Backend Medusa ---
# Générer avec : openssl rand -base64 32 (une valeur distincte pour chacun,
# jamais "supersecret" — voir apps/backend/.env.template)
JWT_SECRET=
COOKIE_SECRET=
ORANGE_MONEY_NUMBER=
ORANGE_MONEY_NAME=Golden Market
N8N_ORDER_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=commandes@golden-market.co

# --- Storefront (variables NEXT_PUBLIC_* injectées au build ET au runtime) ---
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=bf
